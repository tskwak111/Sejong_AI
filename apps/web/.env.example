# Server-side local rewrite target. Never add backend secrets here.
API_INTERNAL_BASE_URL=http://127.0.0.1:8000

# Server-only citizen chat transport mode. `fixture` = demo-5 local mock
# (제안서 7.4 로컬 시연 버전). Select `actual` only while the local API is running;
# the browser always calls same-origin /api/v1/* through the Next rewrite.
CHAT_UI_MODE=fixture

# Server-only local/private administrator route gate. Keep false outside local rehearsal.
ADMIN_UI_ENABLED=false
# Select `actual` only while the local API is running with its private DB composition.
# Fixture and actual data are never combined.
ADMIN_UI_MODE=fixture
