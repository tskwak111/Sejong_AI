# Server-side local rewrite target. Never add backend secrets here.
API_INTERNAL_BASE_URL=http://127.0.0.1:8000

# Server-only citizen chat transport mode. Default (unset) = `actual`:
# the browser calls same-origin /api/v1/* through the Next rewrite and
# connection failures render the safe value-free error card.
# `fixture` is an EXPLICIT opt-in UI development/state-check tool (NOT a
# demo backup — Q-PM-DEMO-001): sample MOCK data only, with an amber
# "시연용 샘플 — 공식 데이터 아님" banner on every screen.
CHAT_UI_MODE=actual

# Server-only local/private administrator route gate. Keep false outside local rehearsal.
ADMIN_UI_ENABLED=false
# Default (unset) = `actual` (typed admin transport against the local API's
# private DB composition). `fixture` is an EXPLICIT opt-in dev tool — sample
# banner shown, approve/reject judgement disabled (ACTIVE transitions are
# actual-only). Fixture and actual data are never combined.
ADMIN_UI_MODE=actual
