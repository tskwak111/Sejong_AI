# Local API process
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:3000

# Database and Supabase values stay blank until the approved local DB slice.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider is disabled by default; keep both modes false unless running one approved local mode.
# Grounded chat requires this exact 8-second/zero-retry profile plus the ignored local key.
# Synthetic evaluation is mutually exclusive and requires its 15-second/one-retry profile.
LLM_PROVIDER=disabled
LLM_MODEL=solar-pro3
LLM_API_KEY=
LLM_BASE_URL=https://api.upstage.ai/v1
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=0
LLM_MAX_CONCURRENCY=1
LLM_MAX_INPUT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=1024
LLM_RUN_ATTEMPT_CAP=30
UPSTAGE_SYNTHETIC_EVALUATION_MODE=false
UPSTAGE_GROUNDED_CHAT_MODE=false

# Signed client-carried context
CONTEXT_TOKEN_SECRET=
CONTEXT_TOKEN_TTL_SECONDS=900

# Privacy and local demonstration defaults
PII_RETENTION_DAYS=30
# Fixed local demo actors. These are identifiers, not secrets or authentication.
DEMO_OPERATOR_ID=OPERATOR-LOCAL-001
DEMO_APPROVER_ID=PM-LOCAL-001
ENABLE_EMBEDDINGS=false
ENABLE_DEMO_ROLE_SWITCH=true
ENABLE_LOAD_TEST_ENDPOINT=false
